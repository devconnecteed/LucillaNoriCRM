// Modello dati piattaforma LN Stile e Portamento (spec v1.0, §11).
// In sviluppo SQLite; per la produzione cambiare provider in "postgresql".
// I valori "enum" sono stringhe validate lato applicazione (vedi src/lib/constants.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String?
  role         String // ADMIN | TEACHER | STUDENT
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  student          Student?
  teacherStudents  Student[]       @relation("TeacherStudents")
  teacherEditions  CourseEdition[]
  invites          Invite[]
  authoredVersions TemplateVersion[]
  auditLogs        AuditLog[]
  quotes           Quote[]
}

model Invite {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Student {
  id               String    @id @default(cuid())
  userId           String?   @unique
  user             User?     @relation(fields: [userId], references: [id])
  teacherId        String
  teacher          User      @relation("TeacherStudents", fields: [teacherId], references: [id])
  firstName        String
  lastName         String
  email            String
  phone            String?
  birthDate        DateTime?
  address          String?
  emergencyContact String?
  status           String    @default("ACTIVE") // ACTIVE | INACTIVE | ARCHIVED
  adminNotes       String?
  // Dati didattici
  goals            String?
  experience       String?
  preferences      String?
  leadSource       String?
  // Campi contestuali Corso Sposa (JSON: weddingDate, venue, ceremonyType, song, dressStyle, train, veil, heels, bouquet)
  bridalInfo       Json?
  // Dato potenzialmente sanitario (art. 9 GDPR): visibile solo a docente assegnata e admin
  physicalNotes    String?
  isMinor          Boolean   @default(false)
  guardianName     String?
  guardianEmail    String?
  guardianPhone    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  enrollments  Enrollment[]
  consents     ConsentRecord[]
  teacherNotes TeacherNote[]
  quotes       Quote[]
}

model TeacherNote {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  authorId  String
  text      String
  createdAt DateTime @default(now())
}

model ConsentRecord {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type      String // PRIVACY | PHYSICAL_DATA | PHOTO | MARKETING
  granted   Boolean
  recordedById String
  createdAt DateTime @default(now())
}

model CourseType {
  id                 String          @id @default(cuid())
  title              String
  slug               String          @unique
  description        String?
  category           String?
  durationLessons    Int?
  durationHours      Float?
  prerequisites      String?
  objectives         String?
  program            String?
  mode               String          @default("INDIVIDUAL") // INDIVIDUAL | GROUP | BOTH
  certificateEnabled Boolean         @default(true)
  // Listino per il preventivatore (centesimi di euro)
  packagePriceCents  Int?
  lessonPriceCents   Int?
  status             String          @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt          DateTime        @default(now())

  editions  CourseEdition[]
  templates QuestionnaireTemplate[]
  quotes    Quote[]
}

model CourseEdition {
  id               String       @id @default(cuid())
  courseTypeId     String
  courseType       CourseType   @relation(fields: [courseTypeId], references: [id])
  teacherId        String
  teacher          User         @relation(fields: [teacherId], references: [id])
  title            String
  startDate        DateTime?
  endDate          DateTime?
  minAttendancePct Int          @default(80)
  status           String       @default("PLANNED") // PLANNED | RUNNING | COMPLETED | CANCELLED
  createdAt        DateTime     @default(now())

  lessons     Lesson[]
  enrollments Enrollment[]
}

model Lesson {
  id          String        @id @default(cuid())
  editionId   String
  edition     CourseEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  number      Int
  date        DateTime?
  topic       String?
  durationMin Int           @default(60)

  attendances Attendance[]
  assignments Assignment[]
}

model Enrollment {
  id        String        @id @default(cuid())
  studentId String
  student   Student       @relation(fields: [studentId], references: [id])
  editionId String
  edition   CourseEdition @relation(fields: [editionId], references: [id])
  status    String        @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | COMPLETED | INTERRUPTED
  createdAt DateTime      @default(now())

  attendances  Attendance[]
  assignments  Assignment[]
  certificates Certificate[]

  @@unique([studentId, editionId])
}

model Attendance {
  id           String     @id @default(cuid())
  lessonId     String
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  present      Boolean
  note         String?

  @@unique([lessonId, enrollmentId])
}

// Modello di questionario: contenitore logico, il contenuto vive nelle versioni.
model QuestionnaireTemplate {
  id           String      @id @default(cuid())
  title        String
  description  String?
  courseTypeId String?
  courseType   CourseType? @relation(fields: [courseTypeId], references: [id])
  phase        String // INITIAL | LESSON | FINAL | EXERCISES | PROFILE
  audience     String      @default("STUDENT") // STUDENT (compila l'allieva) | TEACHER (rubrica docente)
  status       String      @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  sourceFile   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  versions TemplateVersion[]
}

// Versione: una volta pubblicata è immutabile (snapshot usato dalle assegnazioni).
model TemplateVersion {
  id          String                @id @default(cuid())
  templateId  String
  template    QuestionnaireTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version     Int
  content     Json // vedi src/lib/questionnaire/types.ts
  status      String                @default("DRAFT") // DRAFT | PUBLISHED
  authorId    String?
  author      User?                 @relation(fields: [authorId], references: [id])
  publishedAt DateTime?
  createdAt   DateTime              @default(now())

  assignments Assignment[]

  @@unique([templateId, version])
}

model Assignment {
  id           String          @id @default(cuid())
  versionId    String
  version      TemplateVersion @relation(fields: [versionId], references: [id])
  enrollmentId String
  enrollment   Enrollment      @relation(fields: [enrollmentId], references: [id])
  lessonId     String?
  lesson       Lesson?         @relation(fields: [lessonId], references: [id])
  assignedById String
  status       String          @default("SENT") // SENT | OPENED | IN_PROGRESS | COMPLETED | EXPIRED
  availableFrom DateTime?
  dueAt        DateTime?
  maxAttempts  Int             @default(1)
  createdAt    DateTime        @default(now())
  openedAt     DateTime?

  responses Response[]
}

model Response {
  id            String     @id @default(cuid())
  assignmentId  String
  assignment    Assignment @relation(fields: [assignmentId], references: [id])
  attempt       Int        @default(1)
  respondentId  String // utente che compila (allieva o docente per rubriche)
  answers       Json // { [itemId]: valore }
  status        String     @default("DRAFT") // DRAFT | SUBMITTED | REOPENED
  submittedAt   DateTime?
  autoScore     Float?
  maxScore      Float?
  manualScore   Float?
  scoreNote     String?
  teacherFeedback String?
  published     Boolean    @default(false)
  publishedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([assignmentId, attempt])
}

model Certificate {
  id             String     @id @default(cuid())
  number         String     @unique
  enrollmentId   String
  enrollment     Enrollment @relation(fields: [enrollmentId], references: [id])
  title          String     @default("Attestato di partecipazione")
  courseTitle    String
  studentName    String
  periodFrom     DateTime?
  periodTo       DateTime?
  hours          Float?
  issuedAt       DateTime   @default(now())
  issuedById     String
  overrideReason String?
  revokedAt      DateTime?
  revokeReason   String?
}

model Notification {
  id        String    @id @default(cuid())
  to        String
  subject   String
  body      String
  sentAt    DateTime?
  error     String?
  createdAt DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  data      Json?
  createdAt DateTime @default(now())
}

// Preventivo inviato a una potenziale allieva, accettabile tramite link monouso.
// Importi in centesimi; i totali sono sempre ricalcolati lato server (src/lib/quote.ts).
model Quote {
  id               String      @id @default(cuid())
  number           String      @unique
  teacherId        String
  teacher          User        @relation(fields: [teacherId], references: [id])
  courseTypeId     String
  courseType       CourseType  @relation(fields: [courseTypeId], references: [id])
  studentId        String?
  student          Student?    @relation(fields: [studentId], references: [id])
  prospectFirstName String
  prospectLastName String
  prospectEmail    String
  prospectPhone    String?
  lessons          Int
  lessonMinutes    Int         @default(60)
  lines            Json // [{ label, qty, unitCents }]
  discountPct      Float       @default(0)
  vatRate          Float       @default(0)
  subtotalCents    Int
  discountCents    Int
  vatCents         Int
  totalCents       Int
  notes            String?
  validUntil       DateTime
  status           String      @default("DRAFT") // DRAFT | SENT | ACCEPTED | DECLINED | CANCELLED
  tokenHash        String?     @unique
  sentAt           DateTime?
  viewedAt         DateTime?
  acceptedAt       DateTime?
  acceptedName     String?
  acceptedIp       String?
  declinedAt       DateTime?
  declineReason    String?
  editionId        String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}
